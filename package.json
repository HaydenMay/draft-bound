{
  "name": "draft-bound",
  "version": "1.0.0",
  "private": true,
  "description": "A wide-receiver development and collectible-card browser game.",
  "scripts": {
    "start": "ng serve --host 127.0.0.1",
    "build": "ng build",
    "build:pages": "ng build --base-href /draft-bound/",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "balance": "tsx tools/balance-report.ts",
    "typecheck": "tsc --noEmit",
    "icons": "tsx tools/generate-icons.ts",
    "prebuild": "npm run icons",
    "prebuild:pages": "npm run icons",
    "audit:coaching": "tsx tools/coaching-report.ts",
    "audit:art": "tsx tools/art-audit.ts"
  },
  "dependencies": {
    "@angular/common": "21.2.25",
    "@angular/compiler": "21.2.25",
    "@angular/core": "21.2.25",
    "@angular/forms": "21.2.25",
    "@angular/platform-browser": "21.2.25",
    "@fontsource/barlow-condensed": "^5.2.8",
    "@fontsource/dm-sans": "^5.2.8",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular/build": "21.2.25",
    "@angular/cli": "21.2.25",
    "@angular/compiler-cli": "21.2.25",
    "@playwright/test": "^1.58.2",
    "@types/node": "^24.0.0",
    "fake-indexeddb": "^6.2.4",
    "tsx": "^4.21.0",
    "typescript": "~5.9.3",
    "vitest": "^4.0.18"
  }
}
